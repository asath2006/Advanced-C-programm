#include<stdio.h>
#include<string.h>
int main()
{
    int n;
    int c=0;
    int s,e;
    
    char a[250];
    scanf("%s",a);
    n=strlen(a);
    int max=0;
    for(int i=0;i<n;i++)
    {
    
        for(int j=i;j<n;j++)
        {
            c=0;
            int r=0;
            for(int k=i;k<=j;k++)
            {
                for(int m=i;m<k;m++)
                {
                    if(a[k]==a[m])
                    {
                        r=1;
                        break;
                    }
                }
                if(r)
                {
                    break;
                }
                c++;
          }
            if(c>max)
            {
                max=c;
                s=i;
                e=j;
                
            }
            
        }
    }
    printf("%d",max);
    for(int i=s;i<=e;i++)
    {
        printf("%c",a[i]);
    }
}
